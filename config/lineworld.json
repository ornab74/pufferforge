{
  "seed": 1,
  "total_timesteps": 250000,
  "num_envs": 256,
  "horizon": 128,
  "learning_rate": 0.0003,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "update_epochs": 4,
  "minibatch_size": 4096,
  "clip_coef": 0.2,
  "value_clip_coef": 0.2,
  "entropy_coef": 0.01,
  "value_coef": 0.5,
  "max_grad_norm": 0.5,
  "target_kl": 0.02,
  "adam_epsilon": 0.00001,
  "gae_ensemble": [[0.97, 0.9], [0.995, 0.97]],
  "consensus_power": 1.0,
  "value_heads": 3,
  "critic_bootstrap_probability": 0.8,
  "uncertainty_coef": 1.0,
  "transactional_updates": true,
  "rollback_kl": 0.05,
  "rollback_on_nonfinite": true,
  "anneal_lr": true,
  "normalize_advantage": true,
  "device": "auto",
  "cuda_deterministic": false,
  "cuda_allow_tf32": true,
  "hidden_size": 128,
  "hidden_layers": 2,
  "checkpoint_interval": 25,
  "checkpoint_dir": "checkpoints",
  "log_interval": 1
}
